# ============================================================================
# DAM API
# ============================================================================
# Your DAM★とも card number (20-char base64-encoded string)
# Obtain from: https://www.clubdam.com/app/damtomo/scoring/ → URL query param
DAM_CDM_CARD_NO=

# Optional: override endpoint (usually not needed)
# DAM_SCORING_URL=https://www.clubdam.com/app/damtomo/scoring/GetScoringAiListXML.do

# ============================================================================
# Supabase
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
# Use service_role key for PoC (bypasses RLS). In production, switch to auth flow.
SUPABASE_SERVICE_ROLE_KEY=

# The user_id to associate imported scores with (from auth.users)
# For PoC: create a user in Supabase Auth, copy its UUID here
TARGET_USER_ID=

# ============================================================================
# Runtime options
# ============================================================================
# Session boundary: consecutive scores within this many hours belong to the same session
SESSION_GAP_HOURS=3

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
