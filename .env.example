# Repo-root .env template. Copy to `.env` and fill in real values.
# Consumed by scripts/*.py and by the git-push PAT workaround (see CLAUDE.md).
# NEVER commit the filled `.env` — it is gitignored.

# ============================================================================
# DAM API
# ============================================================================
# Your DAM★とも card number (20-char base64-encoded string).
# Obtain from https://www.clubdam.com/app/damtomo/scoring/ URL query param.
DAM_CDM_CARD_NO=

# Optional: override the DAM scoring endpoint.
# DAM_SCORING_URL=https://www.clubdam.com/app/damtomo/scoring/GetScoringAiListXML.do

# ============================================================================
# Supabase
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — bypasses RLS. Required for scripts that seed / migrate.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for schema apply / psycopg2.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase CLI access token (for `supabase functions deploy`).
SUPABASE_ACCESS_TOKEN=

# auth.users UUID that owns the synced scores (single-user MVP).
TARGET_USER_ID=

# ============================================================================
# RLS verification (optional — only if running scripts/verify_rls.py)
# ============================================================================
USER_B_EMAIL=
USER_B_PASSWORD=
USER_B_UUID=

# ============================================================================
# CI / git operations
# ============================================================================
# GitHub PAT used by the git-push workaround documented in CLAUDE.md
# (Windows GCM trap). Scope required: `repo`. Rotate if leaked.
GITHUB_TOKEN=

# ============================================================================
# Runtime options
# ============================================================================
# Session boundary: consecutive scores within this many hours share a session.
SESSION_GAP_HOURS=3

# Python script log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
